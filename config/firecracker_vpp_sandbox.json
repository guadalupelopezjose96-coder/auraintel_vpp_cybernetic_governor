{
  "organization_id": "320717657398",
  "organization_handle": "guadalupelopezjose96-org",
  "vmm_security_baseline": "NIST-SP-800-125A-STRICT",
  "host_kernel_cmdline_required": [
    "intel_iommu=on",
    "amd_iommu=on",
    "iommu=pt",
    "nosmt=force",
    "l1tf=full,force",
    "mds=full,nosmt",
    "spec_store_bypass_disable=on",
    "mitigations=auto,nosmt",
    "kvm.nx_huge_pages=force"
  ],
  "jailer_configuration": {
    "chroot_base_dir": "/srv/jailer/auraintel-vpp",
    "daemonize": true,
    "new_pid_ns": true,
    "netns_isolation": true,
    "cgroup_version": 2,
    "cgroups": {
      "cpu.max": "400000 100000",
      "memory.max": "4294967296",
      "memory.swap.max": "0",
      "pids.max": "64"
    }
  },
  "machine-config": {
    "vcpu_count": 4,
    "mem_size_mib": 4096,
    "smt": false,
    "track_dirty_pages": true
  },
  "seccomp_filter": {
    "default_action": "SCMP_ACT_KILL_PROCESS",
    "allowed_syscalls": [
      "read", "write", "epoll_pwait", "epoll_ctl", "ioctl",
      "mmap", "munmap", "mprotect", "futex", "clock_gettime",
      "close", "fcntl", "sigaltstack", "rt_sigreturn", "exit_group"
    ]
  }
}
